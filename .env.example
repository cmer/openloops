# Bearer token the assistant sends as Authorization: Bearer <API_TOKEN>
# Leave empty and every /api route returns 401.
API_TOKEN=

# Optional read-only token for GET /api/summary, for dashboards such as Homepage.
# API_TOKEN works there too, but this one cannot change anything.
SUMMARY_TOKEN=

# Where the server POSTs each action the person takes on the board.
# Leave the URL empty to keep those actions in the outbox until the assistant acks them.
WEBHOOK_URL=
WEBHOOK_KEY=

# Name shown in the header, ping box, and history. Defaults to Assistant.
ASSISTANT_NAME=Assistant

# Cloudflare Access. Both are required before the UI is served to anyone
# except a loopback request to localhost. The team domain looks like
# team.cloudflareaccess.com. AUD is the Access application's audience tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Local development only. Set to 1 to serve the UI with no Access check.
# Ignored once CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD are both valid.
# Never set this on a machine other people can reach.
INSECURE_ALLOW_UNPROTECTED=

# Optional.
PORT=4732
DATABASE_PATH=./data/openloops.db
NODE_ENV=production
